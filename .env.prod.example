# ═══════════════════════════════════════════════════════════════════════════
# Eduplexo Production Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# Usage:
#   1. Copy this file to `.env` on your production VPS:
#      cp .env.prod.example .env
#   2. Restrict permissions:
#      chmod 600 .env
#   3. Replace placeholder values with real secrets from your secret manager.
#   4. NEVER commit your actual `.env` file to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL Database ───────────────────────────────────────────────────
POSTGRES_DB=eduplexo_prod
POSTGRES_USER=eduplexo_app
# [SECRET] Strong password for PostgreSQL user:
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# ─── Redis Cache & Job Queue ───────────────────────────────────────────────
# [SECRET] Strong password for Redis 7 authentication:
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── Application & Authentication ──────────────────────────────────────────
APP_ENV=production
ENV=production
# [SECRET] 256-bit HMAC secret (generate via: openssl rand -base64 32):
JWT_SECRET=CHANGE_ME_JWT_SECRET_GENERATE_WITH_OPENSSL_RAND_BASE64_32
# Allowed CORS origins (comma-separated, NO trailing slashes, HTTPS only):
ALLOWED_ORIGINS=https://app.eduplexo.com,https://admin.eduplexo.com,https://eduplexo.com,https://www.eduplexo.com
# Must be true in production to enforce SameSite=None; Secure cookies:
COOKIE_SECURE=true

# ─── Primary Domain ────────────────────────────────────────────────────────
DOMAIN=eduplexo.com

# ─── AI Integrations (Optional — Preserved for Future Activation) ───────────
# Leave blank for the current non-AI production release.
# When ready to enable AI features, populate these keys and activate Edubot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Chatbot Tuning (Optional Overrides for Future Activation) ──────────────
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=1800
MAX_HISTORY_PAIRS=10
GEMINI_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20
